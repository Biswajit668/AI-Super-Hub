rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "biswajitnaskar668@gmail.com" ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin") ||
         (exists(/databases/$(database)/documents/admins/$(request.auth.uid))));
    }

    // Users Collection - Owner and Admin only for modifications
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId) || isAdmin();
    }

    // Subscriptions Collection - User can only read/write their own subscription data
    match /subscriptions/{subId} {
      allow read, write, delete: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid) || isAdmin();
    }

    // Usage Collection - User can only read/write their own usage data
    match /usage/{usageId} {
      allow read, write, delete: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid) || isAdmin();
    }

    // History Collection - User can only read, write, and delete their own history
    match /history/{historyId} {
      allow read, write, delete: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid) || isAdmin();
    }

    // Favorites Collection - User can only read, write, and delete their own favorites
    match /favorites/{favId} {
      allow read, write, delete: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid) || isAdmin();
    }

    // Feedback Collection - Any user can submit feedback, only admins or owner can modify/delete
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // Notifications Collection - Public read for broadcasts, admin only write
    match /notifications/{notifId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    // Settings Collection - Read public, write admin only
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tool Requests & Ideas Collection - User can submit, admin manages
    match /toolRequests/{requestId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // Tool Reviews & Ratings Collection - Authenticated users can review
    match /toolReviews/{reviewId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // Promocodes Collection - Public read, admin write
    match /promocodes/{promoId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    // Admins Collection - Admin access only
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write, create, update, delete: if isAdmin();
    }
  }
}
