rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "biswajitnaskar668@gmail.com" ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"));
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() || true;
    }

    // Subscriptions Collection
    match /subscriptions/{subId} {
      allow read, write: if isAuthenticated() || true;
    }

    // Usage Collection
    match /usage/{usageId} {
      allow read, write: if isAuthenticated() || true;
    }

    // History Collection
    match /history/{historyId} {
      allow read, write, delete: if isAuthenticated() || true;
    }

    // Favorites Collection
    match /favorites/{favId} {
      allow read, write: if isAuthenticated() || true;
    }

    // Feedback Collection
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || isAuthenticated();
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read: if true;
      allow write, create, update, delete: if isAuthenticated() || true;
    }

    // Settings Collection
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // Tool Requests & Ideas Collection
    match /toolRequests/{requestId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isAuthenticated();
    }

    // Tool Reviews & Ratings Collection
    match /toolReviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Promocodes Collection
    match /promocodes/{promoId} {
      allow read: if true;
      allow write, create, update, delete: if isAuthenticated() || true;
    }

    // Admins Collection (Separate collection for Admin Data)
    match /admins/{adminId} {
      allow read: if true;
      allow write, create, update, delete: if isAuthenticated() || true;
    }
  }
}
